<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements for AgnView.app.

  allow-unsigned-executable-memory: the app is Python. ctypes and PyObjC build
  call-back trampolines with libffi in writable memory at run time, for
  example for the menu bar icon's menu actions and pywebview's WebKit
  delegates. Without it the hardened runtime stops the app when the first one
  is made.

  Not included:
  - disable-library-validation. Every library in the bundle is signed with
    the same Developer ID during the build, so library validation passes.
  - allow-jit. WebKit runs in its own system processes, which carry their own
    entitlements.
  - App Sandbox and its network entitlements. AgnView is distributed outside
    the Mac App Store, and the hub starts the agent command-line tools from
    the user's PATH, which a sandbox forbids.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
